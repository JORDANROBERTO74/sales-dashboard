# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Encryption key for sensitive financial data in seller_payment_methods.
# AES-256-GCM requires a 256-bit key (64 hex characters).
# Generate with: openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY=your_64_char_hex_key_here

# Stripe (multi-account A/B, independent accounts)
# IMPORTANT:
# - EXTERNAL_ID must exist in public.stripe_accounts.stripe_account_external_id
# - Use test keys/secrets in local/dev and live keys/secrets in production

# Account A
STRIPE_ACCOUNT_A_EXTERNAL_ID=acct_...
STRIPE_ACCOUNT_A_SECRET_KEY=sk_test_...
STRIPE_ACCOUNT_A_WEBHOOK_SECRET=whsec_...

# Account B
STRIPE_ACCOUNT_B_EXTERNAL_ID=acct_...
STRIPE_ACCOUNT_B_SECRET_KEY=sk_test_...
STRIPE_ACCOUNT_B_WEBHOOK_SECRET=whsec_...

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual Supabase/Stripe credentials
# 3. Generate PAYMENT_ENCRYPTION_KEY: openssl rand -hex 32
# 4. For Stripe, configure both accounts (A and B) with matching EXTERNAL_ID values from stripe_accounts
# 5. Never commit .env.local to version control (it's already in .gitignore)


