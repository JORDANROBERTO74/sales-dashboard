# App / White label configuration
# These values are used to brand the dashboard for your business.
NEXT_PUBLIC_APP_NAME=Sales Platform
NEXT_PUBLIC_COMPANY_NAME=Your Company
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOGO_URL=

# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Encryption key for sensitive financial data in seller_payment_methods.
# AES-256-GCM requires a 256-bit key (64 hex characters).
# Generate with: openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY=your_64_char_hex_key_here

# Stripe (multi-account)
# Configure one set of variables per Stripe connected account you want to sync.
# EXTERNAL_ID must exist in public.stripe_accounts.stripe_account_external_id
# Use test keys/secrets in local/dev and live keys/secrets in production.

# Example account 1
STRIPE_ACCOUNT_1_EXTERNAL_ID=acct_...
STRIPE_ACCOUNT_1_SECRET_KEY=sk_test_...
STRIPE_ACCOUNT_1_WEBHOOK_SECRET=whsec_...

# Example account 2
# STRIPE_ACCOUNT_2_EXTERNAL_ID=acct_...
# STRIPE_ACCOUNT_2_SECRET_KEY=sk_test_...
# STRIPE_ACCOUNT_2_WEBHOOK_SECRET=whsec_...

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual Supabase/Stripe credentials
# 3. Generate PAYMENT_ENCRYPTION_KEY: openssl rand -hex 32
# 4. Create Stripe accounts in the admin UI or via Supabase with matching EXTERNAL_ID values
# 5. Never commit .env.local to version control (it's already in .gitignore)
